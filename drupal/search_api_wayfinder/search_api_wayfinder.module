<?php

/**
 * @file
 * Primary module hooks for search_api_wayfinder.
 *
 * The file-extraction invalidation hooks (issue #263) live here: when a file
 * changes or is deleted, every index item referencing it must be marked for
 * reindex. The logic is in \Drupal\search_api_wayfinder\ExtractionInvalidator;
 * these hooks are thin forwarders so the logic stays unit-testable without a
 * bootstrapped Drupal.
 */

declare(strict_types=1);

use Drupal\file\FileInterface;
use Drupal\search_api_wayfinder\ExtractionInvalidator;

/**
 * Implements hook_ENTITY_TYPE_update() for the file entity type.
 *
 * A changed file must re-flow its extracted text into every referencing index
 * item. The cache is content-hash keyed, so an unchanged-content save still
 * reindexes but the re-extraction is a cache hit; see ExtractionInvalidator for
 * why that is acceptable and where a narrower content-change guard would live.
 */
function search_api_wayfinder_file_update(FileInterface $file): void {
  \Drupal::service('search_api_wayfinder.extraction_invalidator')->onFileUpdate($file);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for the file entity type.
 *
 * Referencing items reindex without the deleted attachment's text, and the
 * file's now-dead reference map entry is forgotten so it does not leak.
 */
function search_api_wayfinder_file_delete(FileInterface $file): void {
  \Drupal::service('search_api_wayfinder.extraction_invalidator')->onFileDelete($file);
}
